{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(*.env)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(gh pr create *)"
    ],
    "ask": [],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "editorMode": "vim"
}
